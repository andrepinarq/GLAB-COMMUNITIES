{
  "name": "gavealab-membros",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "bench:auth": "wrangler dev --config tools/auth-bench/wrangler.jsonc",
    "db:migrate:teste": "wrangler d1 migrations apply DB --remote --env teste",
    "db:migrate:producao": "wrangler d1 migrations apply DB --remote --env producao",
    "deploy:teste": "npm test && CLOUDFLARE_ENV=teste vite build && wrangler deploy",
    "deploy:producao": "npm test && CLOUDFLARE_ENV=producao vite build && wrangler deploy",
    "bench:auth:deploy": "wrangler deploy --config tools/auth-bench/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "hash-wasm": "4.12.0",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
